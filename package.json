{
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "test": "vitest run --config vitest.config.ts && node tests/planet_visual.test.cjs && node tests/asset_registry.test.cjs && node tests/asset_files.test.cjs && node tests/icon_system.test.cjs",
    "skills:check": "python3 scripts/validate_agent_skills.py && python3 -m unittest discover -s tests/visual-qa -p skills_test.py",
    "test:design-qa": "node --test tests/visual-qa/checks.test.cjs",
    "qa:visual": "node scripts/visual-qa.cjs",
    "qa": "node scripts/qa.cjs",
    "qa:quick": "node scripts/qa.cjs quick",
    "qa:affected": "node scripts/qa.cjs affected",
    "qa:full": "node scripts/qa.cjs full"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "three": "^0.185.1"
  }
}
