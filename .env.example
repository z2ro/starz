# Development-only defaults. Never reuse this password for an exposed database.
POSTGRES_DB=starz
POSTGRES_USER=starz
POSTGRES_PASSWORD=starz_dev_only
POSTGRES_PORT=5432
APP_PORT=8000
STARZ_UNIVERSE_SEED=STARZ-ALPHA
# Used by commands running on the host (Compose app uses hostname postgres).
DATABASE_URL=postgresql+psycopg://starz:starz_dev_only@localhost:5432/starz
# Optional PostgreSQL integration tests; tests create and drop isolated schemas.
TEST_DATABASE_URL=postgresql+psycopg://starz:starz_dev_only@localhost:5432/starz
